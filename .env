LLM_PROVIDER=gemini-web2api
LLM_BASE_URL=http://localhost:8083/v1
LLM_API_KEY=sk-gemini-argon-local
LLM_MODEL=gemini-3.8-flash
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Vision model (screenshot analysis)
VISION_MODEL=meta/llama-3.2-90b-vision-instruct

SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
SCREENSHOT_MAX_WIDTH=1344
SCREENSHOT_MAX_HEIGHT=756
GRID_ENABLED=true
GRID_STEP=100

BROWSER_CDP_URL=http://localhost:9222

AGENT_MAX_STEPS=50
AGENT_STEP_DELAY=0.1

WEB_HOST=0.0.0.0
WEB_PORT=7860
