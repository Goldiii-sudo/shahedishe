# === LLM Provider ===
# Supported: nvidia, ollama, openai, lmstudio, vllm, custom
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-YOUR-KEY-HERE
LLM_MODEL=z-ai/glm-5.3

# --- Ollama (local) ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llava:34b

# --- LM Studio ---
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=local-model

# --- OpenAI ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=gpt-4o

LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# === Screen ===
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
SCREENSHOT_MAX_WIDTH=1344
SCREENSHOT_MAX_HEIGHT=756
GRID_ENABLED=true
GRID_STEP=100

# === Browser (CDP) ===
# Launch Chrome with: chrome.exe --remote-debugging-port=9222
BROWSER_CDP_URL=http://localhost:9222

# === Agent ===
AGENT_MAX_STEPS=50
AGENT_STEP_DELAY=1.0

# === Web UI ===
WEB_HOST=0.0.0.0
WEB_PORT=7860
